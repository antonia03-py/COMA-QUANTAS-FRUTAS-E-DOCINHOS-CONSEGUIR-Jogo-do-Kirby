#Movimentos
def update(dt):
    global score, lives, game_over, mode, frame

    if mode == "menu":
        staries()
        return
        
    if mode != "game":
        return

    #PP
    #DIREITA E ESQUERDA
    if keyboard.right:
        pp.x += 5
        frame += 0.2   # controla a velocidade da animação
        if frame >= len(kirby_right):
            frame = 0
        pp.image = kirby_right[int(frame)]

    elif keyboard.left:
        pp.x -= 5
        frame += 0.2
        if frame >= len(kirby_left):
            frame = 0
        pp.image = kirby_left[int(frame)]

    else:
        pp.image = "kirbyparados"
        frame = 0

    #PAREEEEEEE
    if pp.x < 60:
        pp.x = 60
    if pp.x > 740:
        pp.x = 740

    ###FRUTA E BOLO###
    #CAINDO
    ##CHERRY##
    score = score_ao_comer(pp, cherry, score, 1)

    score = score_ao_comer(pp, blub, score, 1)

    score = score_ao_comer(pp, bolo, score, 1)

    score = score_ao_comer(pp, donut, score, 1)

    score = score_ao_comer(pp, sapo, score, -3)
    
    #BOOOOOM!!!!!
    bomb.y += 5 + score / 5 
    if bomb.y > 600:
        bomb.x = random.randint(20, 780)
        bomb.y = 0
    #KABOOM
    if bomb.colliderect(pp):
        #ADICIONAR SOM
        bomb.x = random.randint(20, 780)
        bomb.y = 0
        if hearts:
            hearts.pop() 
            lives -= 1

    #BOOOOOM!!!!!
    bomb2.y += 5 + score / 5 
    if bomb2.y > 600:
        bomb2.x = random.randint(20, 780)
        bomb2.y = 0
    #KABOOM
    if bomb2.colliderect(pp):
        #ADICIONAR SOM
        bomb2.x = random.randint(20, 780)
        bomb2.y = 0
        if hearts:
            hearts.pop() 
            lives -= 1
            
    #GAME OVER
    if lives == 0:
        mode = "game_over"
        cherry.y = 0
        blub.y = 0
        bolo.y = 0
        donut.y = 0
        bomb.y = 0
        bomb2.y = 0
        sapo.y = 0
         
