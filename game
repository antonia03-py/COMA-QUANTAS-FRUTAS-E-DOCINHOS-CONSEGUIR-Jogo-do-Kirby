def staries():
    for star in stars:
        star.y += star.speed
        star.angle += star.rotation_speed
        if star.y > 580:
            star.x = random.randint(0, 800)
            star.y = -20
            star.speed = random.randint(2, 15)
            star.rotation_speed = random.randint(2, 8)
            star.angle = 0

def score_ao_comer(pp, comida, score, score_impact):
    comida.y += 4 + score / 5 # OU cherry.y = cherry.y + 4
    #LOOP
    if comida.y > 600:
        comida.x = random.randint(20, 780)
        comida.y = 0
    #YUMMY COLISAO COM O PP
    if comida.colliderect(pp):
        #ADICIONAR SOM
        comida.x = random.randint(20, 780)
        comida.y = 0
        score += score_impact
    
    return score

